{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "modifiers.options.update",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "option_id",
    "name"
  ],
  "properties": {
    "option_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Opcion a editar."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "kitchen_name": {
      "type": "string",
      "default": "",
      "maxLength": 255
    },
    "price_delta": {
      "type": "integer",
      "default": 0,
      "description": "Unidad entera del contrato de dinero. Puede ser negativo."
    },
    "tax_category_key": {
      "type": "string",
      "default": "",
      "maxLength": 80,
      "description": "Vacio = hereda el de la linea. Con valor se aplica SOLO a su delta y nunca reescribe el del padre (ADR-0376)."
    },
    "sort_order": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    }
  }
}
