{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "modifiers.groups.create",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "kitchen_name": {
      "type": "string",
      "default": "",
      "maxLength": 255,
      "description": "Nombre para la comanda. Vacio = usa `name` (regla de Toast)."
    },
    "min_choices": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50,
      "default": 0,
      "description": "1 o mas ES la obligatoriedad. No existe un flag `required`."
    },
    "max_choices": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50,
      "default": 0,
      "description": "0 = sin techo. Si no es 0, debe ser >= min_choices."
    },
    "allow_repeat": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "default": 0
    },
    "sort_order": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    }
  }
}
