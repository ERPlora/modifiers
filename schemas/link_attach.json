{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "modifiers.links.attach",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "group_id",
    "target_kind",
    "target_ref"
  ],
  "properties": {
    "group_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Grupo a enganchar."
    },
    "target_kind": {
      "type": "string",
      "enum": [
        "product",
        "service",
        "category"
      ],
      "description": "Referencia OPACA: este modulo no sabe que hay detras."
    },
    "target_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Id del articulo en el modulo que lo vende. Sin clave ajena."
    },
    "sort_order": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    }
  }
}
